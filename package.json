{
  "name": "daily-reminder-schedule",
  "version": "0.1.0",
  "description": "本地每日提醒与日程 Windows 桌面应用",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test",
    "test:electron": "electron scripts/smoke-updates.cjs",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "dist:portable": "electron-builder --win portable --x64 --publish never",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.local.dailyreminder",
    "productName": "每日提醒与日程",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Daily-Reminder-Schedule-${version}-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "zhaobin-07",
        "repo": "daily-reminder-schedule",
        "private": false,
        "releaseType": "release"
      }
    ],
    "nsis": {
      "artifactName": "Daily-Reminder-Schedule-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Daily-Reminder-Schedule-Portable-${version}-${arch}.${ext}"
    }
  }
}
